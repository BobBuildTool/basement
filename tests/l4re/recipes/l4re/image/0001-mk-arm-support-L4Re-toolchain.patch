The plain armelf emulation resolves TARGET2 relocations as absolute or
pc-relative. The L4Re toolchain unwinder expects them as pc-relative
GOT entries, which only armelf_l4re provides.

--- a/mk/arch/Makeconf.arm
+++ b/mk/arch/Makeconf.arm
@@ -2,7 +2,7 @@
 
 CROSS_COMPILE_arm         = arm-linux-gnueabihf-
 ASFLAGS_arm               = -Wa,--noexecstack
-LD_EMULATION_CHOICE_arm   = armelf armelf_linux_eabi
+LD_EMULATION_CHOICE_arm   = armelf_l4re armelf armelf_linux_eabi
 LDFLAGS_arm              += $(call if_for_target,-z max-page-size=0x1000 \
                                                  -z common-page-size=0x1000 \
                                                  -z noexecstack)
