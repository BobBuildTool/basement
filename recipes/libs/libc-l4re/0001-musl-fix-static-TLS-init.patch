Fix static TLS initialization of musl on L4Re

The L4Re loader passes AT_PHDR only for binaries with a PT_PHDR segment.
Static executables usually lack it, so their TLS segment was never set
up. Additionally, MIN_TLS_ALIGN evaluated to 1, which leads to an
unaligned DTV.

--- a/pkg/l4re-core/libc/musl/contrib/musl/src/env/__init_tls.c
+++ b/pkg/l4re-core/libc/musl/contrib/musl/src/env/__init_tls.c
@@ -34,7 +34,7 @@ int __init_tp(pthread_descr p)
 static struct builtin_tls {
 	char c;
 	// TODO: Give musl access to "struct pthread"?
-	char pt[512]; // TOOD: The alignment might be wrong...
+	char pt[512] __attribute__((aligned(sizeof(long long))));
 	// struct pthread pt; // Ooops, this is broken now...
 	void *space[16];
 } builtin_tls[1];
@@ -86,12 +86,15 @@ pthread_descr __copy_tls(unsigned char *
 }
 
 #if ULONG_MAX == 0xffffffff
+typedef Elf32_Ehdr Ehdr;
 typedef Elf32_Phdr Phdr;
 #else
+typedef Elf64_Ehdr Ehdr;
 typedef Elf64_Phdr Phdr;
 #endif
 
 extern weak hidden const size_t _DYNAMIC[];
+extern weak hidden const unsigned char __ehdr_start[];
 
 static void static_init_tls(size_t *aux)
 {
@@ -101,6 +104,15 @@ static void static_init_tls(size_t *aux)
 	size_t base = 0;
 	void *mem;
 
+	/* The L4Re loader passes AT_PHDR only if the binary has a PT_PHDR
+	 * segment, which static executables usually lack. */
+	if (!aux[AT_PHDR] && __ehdr_start) {
+		const Ehdr *ehdr = (const void *)__ehdr_start;
+		aux[AT_PHDR] = (size_t)__ehdr_start + ehdr->e_phoff;
+		aux[AT_PHNUM] = ehdr->e_phnum;
+		aux[AT_PHENT] = ehdr->e_phentsize;
+	}
+
 	for (p=(void *)aux[AT_PHDR],n=aux[AT_PHNUM]; n; n--,p+=aux[AT_PHENT]) {
 		phdr = (void *)p;
 		if (phdr->p_type == PT_PHDR)
