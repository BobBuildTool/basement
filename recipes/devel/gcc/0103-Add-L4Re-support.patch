diff --git a/gcc/config/mips/l4re.h b/gcc/config/mips/l4re.h
new file mode 100644
index 000000000..ec4461dcb
--- /dev/null
+++ b/gcc/config/mips/l4re.h
@@ -0,0 +1,92 @@
+/* Definitions for MIPS L4Re systems with ELF format.
+   Copyright (C) 1998-2025 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+/* Like the other GNU userspace targets, L4Re uses a 32 bit wchar_t.  */
+#undef  WCHAR_TYPE
+#define WCHAR_TYPE "int"
+
+#undef  WCHAR_TYPE_SIZE
+#define WCHAR_TYPE_SIZE 32
+
+/* Without MASK_ABICALLS we cannot default to PIC, which the shared
+   libraries of L4Re require.  */
+#undef  TARGET_DEFAULT
+#define TARGET_DEFAULT MASK_ABICALLS
+
+/* -G is incompatible with -KPIC which is the default, so only allow objects
+   in the small data section if the user explicitly asks for it.  */
+#undef  MIPS_DEFAULT_GVALUE
+#define MIPS_DEFAULT_GVALUE 0
+
+#undef  SUBTARGET_ASM_SPEC
+#define SUBTARGET_ASM_SPEC \
+  "%{!mno-abicalls:%{mplt:-call_nonpic;:-KPIC}}"
+
+#undef  SUBTARGET_CPP_SPEC
+#define SUBTARGET_CPP_SPEC "%{posix:-D_POSIX_SOURCE} %{pthread:-D_REENTRANT}"
+
+/* Even though we disable multilib, mips.h redirects the startfile prefixes
+   to /lib32 resp. /lib64 for the n32 and n64 ABIs. Get rid of this behaviour
+   because we consistently use /usr/lib for all our libraries.  */
+#undef  STANDARD_STARTFILE_PREFIX_1
+#define STANDARD_STARTFILE_PREFIX_1 "/lib/"
+#undef  STANDARD_STARTFILE_PREFIX_2
+#define STANDARD_STARTFILE_PREFIX_2 "/usr/lib/"
+
+/* The new ABIs use "." as the local label prefix.  */
+#undef  LOCAL_LABEL_PREFIX
+#define LOCAL_LABEL_PREFIX (TARGET_OLDABI ? "$" : ".")
+
+/* The libc _mcount stub saves $v0 for us. Don't mess with saving it, since
+   ASM_OUTPUT_REG_PUSH/ASM_OUTPUT_REG_POP do not work in the presence of
+   $gp-relative calls.  */
+#undef ASM_OUTPUT_REG_PUSH
+#undef ASM_OUTPUT_REG_POP
+
+/* Make sure the endianness and the ABI are always explicit on the command
+   line. The link spec below relies on it.  */
+#define L4RE_DRIVER_SELF_SPECS					\
+  "%{!EB:%{!EL:%(endian_spec)}}",				\
+  "%{!mabi=*: -" MULTILIB_ABI_DEFAULT "}"
+
+#undef  DRIVER_SELF_SPECS
+#define DRIVER_SELF_SPECS	\
+  MIPS_ISA_LEVEL_SPEC,		\
+  BASE_DRIVER_SELF_SPECS,	\
+  L4RE_DRIVER_SELF_SPECS
+
+/* Prepend the architecture specific options to the generic L4Re link spec.
+   The linker emulation has to match the selected ABI and endianness. L4Re
+   expects the "traditional" MIPS ELF flavour, same as Linux.
+
+   Binutils is configured with --enable-default-hash-style=gnu. On MIPS that
+   emits a .MIPS.xhash (DT_MIPS_XHASH) section instead of a classic DT_HASH or
+   DT_GNU_HASH. The musl dynamic linker only understands DT_HASH/DT_GNU_HASH,
+   so ask for both hash styles to keep a usable DT_HASH in every shared object
+   we produce. This is what L4Re does for its own libraries as well, but
+   libgcc_s.so and libstdc++.so are linked by us. A later -Wl,--hash-style=
+   still wins because the user options are passed after the link spec.  */
+#undef  LINK_SPEC
+#define LINK_SPEC "\
+--hash-style=both \
+%{G*} %{EB} %{EL} %{mips*} \
+%{mabi=32:-melf32%{EB:b}%{EL:l}tsmip} \
+%{mabi=n32:-melf32%{EB:b}%{EL:l}tsmipn32} \
+%{mabi=64:-melf64%{EB:b}%{EL:l}tsmip_l4re} " \
+L4RE_TARGET_LINK_SPEC
diff --git a/gcc/config/riscv/l4re.h b/gcc/config/riscv/l4re.h
new file mode 100644
index 000000000..398d8529c
--- /dev/null
+++ b/gcc/config/riscv/l4re.h
@@ -0,0 +1,44 @@
+/* Definitions for RISC-V L4Re systems with ELF format.
+   Copyright (C) 1998-2025 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+/* Provided by libc. See l4re-core/uclibc. */
+#define ICACHE_FLUSH_FUNC "__riscv_flush_icache"
+
+#undef  CPP_SPEC
+#define CPP_SPEC "%{pthread:-D_REENTRANT}"
+
+#define LD_EMUL_SUFFIX \
+  "%{mabi=lp64d:}" \
+  "%{mabi=lp64f:_lp64f}" \
+  "%{mabi=lp64:_lp64}" \
+  "%{mabi=ilp32d:}" \
+  "%{mabi=ilp32f:_ilp32f}" \
+  "%{mabi=ilp32:_ilp32}"
+
+/* Prepend the architecture specific options to the generic L4Re link spec.
+   The linker emulation has to match the selected ABI and the relaxation
+   option must be passed through.  */
+#undef  LINK_SPEC
+#define LINK_SPEC "\
+-melf" XLEN_SPEC DEFAULT_ENDIAN_SPEC "riscv" LD_EMUL_SUFFIX " \
+%{mno-relax:--no-relax} \
+-X \
+%{mbig-endian:-EB} \
+%{mlittle-endian:-EL} " \
+L4RE_TARGET_LINK_SPEC
diff --git a/gcc/configure.ac b/gcc/configure.ac
index cb743b5a8..c5a042a0e 100644
--- a/gcc/configure.ac
+++ b/gcc/configure.ac
@@ -7032,7 +7032,7 @@ AC_CACHE_CHECK(__stack_chk_fail in target C library,
 	 # realistically usable GNU/Hurd configurations.
 	 # All supported versions of musl provide it as well
 	 gcc_cv_libc_provides_ssp=yes;;
-       *-*-darwin* | *-*-freebsd* | *-*-netbsd*)
+       *-*-darwin* | *-*-freebsd* | *-*-netbsd* | *-*-l4re*)
 	 AC_CHECK_FUNC(__stack_chk_fail,[gcc_cv_libc_provides_ssp=yes],
            [echo "no __stack_chk_fail on this target"])
         ;;
diff --git a/libgcc/config.host b/libgcc/config.host
index ee10e99b0..69fb7b04a 100644
--- a/libgcc/config.host
+++ b/libgcc/config.host
@@ -310,6 +310,10 @@ case ${host} in
   tmake_file="$tmake_file t-crtstuff-pic t-libgcc-pic t-eh-dw2-dip t-slibgcc t-slibgcc-fuchsia"
   extra_parts="crtbegin.o crtend.o"
