From: =?UTF-8?q?Jan=20Kl=C3=B6tzke?= <jan.kloetzke@kernkonzept.com>
Date: Mon, 12 May 2025 17:01:30 +0200
Subject: [PATCH 5/5] Add L4Re support

diff --git a/gcc/config.gcc b/gcc/config.gcc
index a3566f5c7..0a187a0ac 100644
--- a/gcc/config.gcc
+++ b/gcc/config.gcc
@@ -884,6 +884,24 @@ case ${target} in
   rust_target_objs="${rust_target_objs} fuchsia-rust.o"
   target_has_targetrustm=yes
   ;;
+*-*-l4re*)
+  extra_options="$extra_options l4re.opt"
+  gas=yes
+  gnu_ld=yes
+  default_use_cxa_atexit=yes
+  tmake_file="t-slibgcc"
+  case ${enable_threads} in
+    "" | yes | posix) thread_file='posix' ;;
+    no) ;;
+    *)
+      echo 'Unknown thread configuration for L4Re'
+      exit 1
+      ;;
+  esac
+  # The L4Re linker scripts reject .ctors/.dtors. Configure cannot detect
+  # .init_array support when building without target headers.
+  gcc_cv_initfini_array=yes
+  ;;
 *-*-linux* | frv-*-*linux* | *-*-kfreebsd*-gnu | *-*-gnu* | *-*-kopensolaris*-gnu | *-*-uclinuxfdpiceabi)
   extra_options="$extra_options gnu-user.opt"
   gas=yes
@@ -1189,8 +1207,16 @@ case ${target} in
 esac
 
 case ${target} in
-aarch64*-*-elf | aarch64*-*-fuchsia* | aarch64*-*-rtems*)
-	tm_file="${tm_file} elfos.h newlib-stdint.h"
+aarch64*-*-elf | aarch64*-*-fuchsia* | aarch64*-*-rtems* | aarch64*-*-l4re*)
+	case $target in
+	aarch64*-*-l4re*)
+		# L4Re is based on musl, which follows the glibc conventions.
+		tm_file="${tm_file} elfos.h glibc-stdint.h"
+		;;
+	*)
+		tm_file="${tm_file} elfos.h newlib-stdint.h"
+		;;
+	esac
 	tm_file="${tm_file} aarch64/aarch64-elf.h aarch64/aarch64-errata.h aarch64/aarch64-elf-raw.h"
 	tmake_file="${tmake_file} aarch64/t-aarch64"
 	case $target in
@@ -1200,6 +1226,9 @@ aarch64*-*-elf | aarch64*-*-fuchsia* | aarch64*-*-rtems*)
         aarch64-*-fuchsia*)
                 tm_file="${tm_file} fuchsia.h"
                 ;;
+        aarch64-*-l4re*)
+                tm_file="${tm_file} l4re.h"
+                ;;
 	aarch64-*-rtems*)
 		tm_file="${tm_file} aarch64/rtems.h rtems.h"
 		tmake_file="${tmake_file} aarch64/t-aarch64-rtems"
@@ -1468,7 +1497,7 @@ arm*-*-phoenix*)
 	tmake_file="${tmake_file} arm/t-arm arm/t-bpabi arm/t-phoenix"
 	target_cpu_cname="arm7tdmi"
 	;;
-arm*-*-eabi* | arm*-*-symbianelf* | arm*-*-rtems* | arm*-*-fuchsia*)
+arm*-*-eabi* | arm*-*-symbianelf* | arm*-*-rtems* | arm*-*-fuchsia* | arm*-*-l4re*)
 	case ${target} in
 	arm*eb-*-eabi*)
 	  tm_defines="${tm_defines} TARGET_BIG_ENDIAN_DEFAULT=1"
@@ -1488,6 +1517,11 @@ arm*-*-eabi* | arm*-*-symbianelf* | arm*-*-rtems* | arm*-*-fuchsia*)
 	  tmake_file="${tmake_file} arm/t-bpabi arm/t-fuchsia"
 	  target_cpu_cname="generic-armv7-a"
 	  ;;
+	arm*-*-l4re*)
+	  tm_file="${tm_file} l4re.h glibc-stdint.h"
+	  tmake_file="${tmake_file} arm/t-bpabi"
+	  target_cpu_cname="generic-armv7-a"
+	  ;;
 	arm*-*-rtems*)
 	  tm_file="${tm_file} arm/rtems.h rtems.h newlib-stdint.h"
 	  tmake_file="${tmake_file} arm/t-bpabi arm/t-rtems"
@@ -2288,6 +2322,11 @@ x86_64-*-fuchsia*)
 	tmake_file="${tmake_file} i386/t-x86_64-elf"
 	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h newlib-stdint.h i386/i386elf.h i386/x86-64.h fuchsia.h"
 	;;
+x86_64-*-l4re*)
+	tmake_file="${tmake_file} i386/t-x86_64-elf"
+	# L4Re is based on musl, which follows the glibc conventions.
+	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h glibc-stdint.h i386/i386elf.h i386/x86-64.h l4re.h i386/l4re64.h"
+	;;
 ia64*-*-elf*)
 	tm_file="${tm_file} elfos.h newlib-stdint.h ia64/sysv4.h ia64/elf.h"
 	tmake_file="ia64/t-ia64"
@@ -2504,6 +2543,23 @@ riscv*-*-linux*)
 	gcc_cv_initfini_array=yes
 	with_tls=${with_tls:-trad}
 	;;
+riscv*-*-l4re*)
+	tm_file="elfos.h glibc-stdint.h ${tm_file} l4re.h riscv/l4re.h"
+	tmake_file="${tmake_file} riscv/t-riscv"
+	tm_defines="${tm_defines} TARGET_DEFAULT_ASYNC_UNWIND_TABLES=1"
+	gnu_ld=yes
+	gas=yes
+	case $target in
+	riscv32be-*|riscv64be-*)
+		tm_defines="${tm_defines} TARGET_BIG_ENDIAN_DEFAULT=1"
+		;;
+	esac
+	# Force .init_array support.  The configure script cannot always
+	# automatically detect that GAS supports it, yet we require it.
+	gcc_cv_initfini_array=yes
+	# The libc does not support TLS descriptors.
+	with_tls=${with_tls:-trad}
+	;;
 riscv*-*-elf* | riscv*-*-rtems*)
 	tm_file="elfos.h newlib-stdint.h ${tm_file} riscv/elf.h"
 	case ${target} in
@@ -2601,6 +2657,36 @@ mips*-mti-linux*)
 	gnu_ld=yes
 	gas=yes
 	;;
+mips*-*-l4re*)				# L4Re MIPS, either endian.
+	tm_file="elfos.h glibc-stdint.h ${tm_file} mips/elf.h l4re.h mips/l4re.h"
+	gnu_ld=yes
+	gas=yes
+	# L4Re supports exactly these four CPU variants (see mk/arch/Kconfig.mips.inc).
+	case ${target} in
+		mipsisa32r2*)
+			default_mips_arch=mips32r2
+			default_mips_abi=32
+			;;
+		mipsisa32r6*)
+			default_mips_arch=mips32r6
+			default_mips_abi=32
+			;;
+		mipsisa64r2*)
+			default_mips_arch=mips64r2
+			default_mips_abi=64
+			;;
+		mipsisa64r6*)
+			default_mips_arch=mips64r6
+			default_mips_abi=64
+			;;
+		mips64*)
+			default_mips_abi=64
+			;;
+	esac
+	# Force .init_array support.  The configure script cannot always
+	# automatically detect that GAS supports it, yet we require it.
+	gcc_cv_initfini_array=yes
+	;;
 mips*-*-linux*)				# Linux MIPS, either endian.
 	tm_file="elfos.h gnu-user.h linux.h linux-android.h glibc-stdint.h ${tm_file} mips/gnu-user.h mips/linux.h mips/linux-common.h"
 	extra_options="${extra_options} linux-android.opt"
diff --git a/gcc/config.host b/gcc/config.host
index f640029b5..840698517 100644
--- a/gcc/config.host
+++ b/gcc/config.host
@@ -100,7 +100,7 @@ esac
 
 case ${host} in
   aarch64*-*-freebsd* | aarch64*-*-linux* | aarch64*-*-fuchsia* |\
-  aarch64*-*-darwin*)
+  aarch64*-*-darwin* | aarch64*-*-l4re*)
     case ${target} in
       aarch64*-*-*)
 	host_extra_gcc_objs="driver-aarch64.o"
@@ -108,7 +108,8 @@ case ${host} in
 	;;
     esac
     ;;
-  arm*-*-freebsd* | arm*-*-netbsd* | arm*-*-linux* | arm*-*-fuchsia*)
+  arm*-*-freebsd* | arm*-*-netbsd* | arm*-*-linux* | arm*-*-fuchsia* |\
+  arm*-*-l4re*)
     case ${target} in
       arm*-*-*)
 	host_extra_gcc_objs="driver-arm.o"
diff --git a/gcc/config/i386/l4re64.h b/gcc/config/i386/l4re64.h
new file mode 100644
index 000000000..874f5dcfa
--- /dev/null
+++ b/gcc/config/i386/l4re64.h
@@ -0,0 +1,16 @@
+#ifdef TARGET_LIBC_PROVIDES_SSP
+/* Like Linux glibc/uclibc, L4Re/musl uses __stack_chk_guard in %gs:0x14 on
+ * i386 and %fs:0x28 on x86_64. */
+#define TARGET_THREAD_SSP_OFFSET \
+  (TARGET_64BIT ? 0x28 : 0x14)
+#endif
+
+/* Prepend the architecture specific options to the generic L4Re link spec.
+   The linker emulation has to match the selected multilib.  */
+#undef  LINK_SPEC
+#define LINK_SPEC "\
+%{m32:-m elf_i386}%{m64:-m elf_x86_64} " \
+L4RE_TARGET_LINK_SPEC
+
+#undef  MULTILIB_DEFAULTS
+#define MULTILIB_DEFAULTS { "m64" }
diff --git a/gcc/config/l4re.h b/gcc/config/l4re.h
new file mode 100644
index 000000000..f6ad57e43
--- /dev/null
+++ b/gcc/config/l4re.h
@@ -0,0 +1,79 @@
+/* The GNU C++ standard library requires that these macros be defined.  */
+#undef CPLUSPLUS_CPP_SPEC
+#define CPLUSPLUS_CPP_SPEC "-D_GNU_SOURCE %(cpp)"
+
+#undef  STARTFILE_SPEC
+#define STARTFILE_SPEC \
+  "%{shared:; \
+     static:crt1.o%s; \
+     static-pie:crt1.p.o%s; \
+     " PIE_SPEC ":crt1.s.o%s; \
+     :crt1.o%s} " \
+   "%{shared:crti.s.o%s;:crti.o%s} " \
+   "%{static:crtbeginT.o%s; \
+     shared|static-pie|" PIE_SPEC ":crtbeginS.o%s; \
+     :crtbegin.o%s} "
+
+#undef  ENDFILE_SPEC
+#define ENDFILE_SPEC \
+   "%{static:crtend.o%s; \
+     shared|static-pie|" PIE_SPEC ":crtendS.o%s; \
+     :crtend.o%s} " \
+   "%{shared:crtn.s.o%s;:crtn.o%s} "
+
+#undef  LIB_SPEC
+#define LIB_SPEC "-lc"
+
+#if defined(HAVE_LD_EH_FRAME_HDR)
+#define LINK_EH_SPEC "%{!static|static-pie:--eh-frame-hdr} "
+#endif
+
+/* The OS part of the link spec. Targets that need to pass additional,
+   architecture specific options to the linker can include this in their own
+   LINK_SPEC definition.  */
+#define L4RE_TARGET_LINK_SPEC "\
+  %{shared:-shared} \
+  %{!shared: \
+    %{!static: \
+      %{!static-pie: \
+        %{rdynamic:-export-dynamic} \
+        -dynamic-linker=/rom/libc.so.1}} \
+    %{static:-static} \
+    %{static-pie:-static -pie --no-dynamic-linker -z text}}"
+
+#undef  LINK_SPEC
+#define LINK_SPEC L4RE_TARGET_LINK_SPEC
+
+#define GNU_USER_TARGET_LINK_GCC_C_SEQUENCE_SPEC \
+  "%{static|static-pie:--start-group} %G %{!nolibc:%L} \
+   %{static|static-pie:--end-group}%{!static:%{!static-pie:%G}}"
+
+#undef LINK_GCC_C_SEQUENCE_SPEC
+#define LINK_GCC_C_SEQUENCE_SPEC GNU_USER_TARGET_LINK_GCC_C_SEQUENCE_SPEC
+
+/* Use --as-needed -lgcc_s for eh support.  */
+#ifdef HAVE_LD_AS_NEEDED
+#define USE_LD_AS_NEEDED 1
+#endif
+
+/* We are using MUSL as our libc.  */
+#undef  OPTION_MUSL
+#define OPTION_MUSL 1
+#undef  OPTION_MUSL_P
+#define OPTION_MUSL_P(opts) 1
+
+#ifndef TARGET_SUB_OS_CPP_BUILTINS
+#define TARGET_SUB_OS_CPP_BUILTINS()
+#endif
+
+#undef  TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      builtin_define ("__l4re__");		\
+      TARGET_SUB_OS_CPP_BUILTINS();		\
+    }						\
+  while (false)
+
+/* Add .note.GNU-stack special section */
+#define TARGET_ASM_FILE_END file_end_indicate_exec_stack
