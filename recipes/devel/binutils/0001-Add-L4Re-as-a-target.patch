+   along with GAS; see the file COPYING.  If not, write to the Free
+   Software Foundation, 51 Franklin Street - Fifth Floor, Boston, MA
+   02110-1301, USA.  */
+
+#include "te-l4re.h"
+
+/* The EABI requires the use of VFP.  */
+#define FPU_DEFAULT FPU_ARCH_SOFTVFP
+#define EABI_DEFAULT EF_ARM_EABI_VER5
+
diff -Nurp a/gas/config/te-l4re.h b/gas/config/te-l4re.h
--- a/gas/config/te-l4re.h
+++ b/gas/config/te-l4re.h
@@ -0,0 +1,31 @@
+/* te-l4re.h -- L4Re target environment declarations.
+   Copyright (C) 2000-2025 Free Software Foundation, Inc.
+
+   This file is part of GAS, the GNU Assembler.
+
+   GAS is free software; you can redistribute it and/or modify
+   it under the terms of the GNU General Public License as published by
+   the Free Software Foundation; either version 3, or (at your option)
+   any later version.
+
+   GAS is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+   GNU General Public License for more details.
+
+   You should have received a copy of the GNU General Public License
+   along with GAS; see the file COPYING.  If not, write to the Free
+   Software Foundation, 51 Franklin Street - Fifth Floor, Boston, MA
+   02110-1301, USA.  */
+
+/* Target environment for L4Re. It is the same as the generic
+   target, except that it arranges via the TE_L4Re define to
+   suppress the use of "/" as a comment character.  Some code in the
+   L4Re kernel uses "/" to mean division.  (What a concept!)  */
+#define TE_L4Re 1
+
+#define LOCAL_LABELS_DOLLAR 1
+#define LOCAL_LABELS_FB 1
+
+#include "obj-format.h"
+
diff -Nurp a/gas/configure b/gas/configure
--- a/gas/configure
+++ b/gas/configure
@@ -12646,7 +12646,8 @@ _ACEOF
 	esac
 	# Decide which ABI to target by default.
 	case ${target} in
-	  mips64*-openbsd* | mips64*-linux-gnuabi64)
+	  mips64*-openbsd* | mips64*-linux-gnuabi64 \
+	  | mips64*-*-l4re* | mipsisa64*-*-l4re*)
 	    mips_default_abi=N64_ABI
 	    ;;
 	  mips64*-linux* | mips-sgi-irix6* | mips64*-freebsd* \
diff -Nurp a/gas/configure.ac b/gas/configure.ac
--- a/gas/configure.ac
+++ b/gas/configure.ac
@@ -391,7 +391,8 @@ changequote([,])dnl
 	esac
 	# Decide which ABI to target by default.
 	case ${target} in
-	  mips64*-openbsd* | mips64*-linux-gnuabi64)
+	  mips64*-openbsd* | mips64*-linux-gnuabi64 \
+	  | mips64*-*-l4re* | mipsisa64*-*-l4re*)
 	    mips_default_abi=N64_ABI
 	    ;;
 	  mips64*-linux* | mips-sgi-irix6* | mips64*-freebsd* \
diff -Nurp a/gas/configure.tgt b/gas/configure.tgt
--- a/gas/configure.tgt
+++ b/gas/configure.tgt
@@ -130,6 +130,7 @@ case ${generic_target} in
   aarch64*-*-fuchsia*)			fmt=elf;;
   aarch64*-*-haiku*)			fmt=elf em=haiku ;;
   aarch64*-*-genode*)			fmt=elf;;
+  aarch64*-*-l4re*)			fmt=elf em=l4re;;
   aarch64*-*-linux*)			fmt=elf em=linux
     case ${cpu}-${os} in
       aarch64*-linux-gnu_ilp32)		arch=aarch64:32 ;;
@@ -168,6 +169,7 @@ case ${generic_target} in
   arm-*-pe)				fmt=coff em=pe ;;
   arm-*-fuchsia*)			fmt=elf ;;
   arm-*-haiku*)				fmt=elf em=haiku ;;
+  arm-*-l4re*)				fmt=elf em=arml4reeabi ;;
 
   avr-*-*)				fmt=elf bfd_gas=yes ;;
 
@@ -231,6 +233,7 @@ case ${generic_target} in
   i386-*-fuchsia*)			fmt=elf ;;
   i386-*-haiku*)			fmt=elf em=haiku ;;
   i386-*-genode*)			fmt=elf ;;
+  i386-*-l4re*)				fmt=elf em=l4re ;;
   i386-*-bsd*)				fmt=aout em=386bsd ;;
   i386-*-netbsd*-gnu* | \
   i386-*-knetbsd*-gnu | \
@@ -316,6 +319,7 @@ case ${generic_target} in
   mips-*-irix6*)			fmt=elf em=irix ;;
   mips-*-irix5*)			fmt=elf em=irix ;;
   mips*-*-linux*)			fmt=elf em=tmips ;;
+  mips*-*-l4re*)			fmt=elf em=tmips ;;
   mips*-*-freebsd* | mips*-*-kfreebsd*-gnu)
 					fmt=elf em=freebsd ;;
   mips-*-sysv4* | mips-*-gnu*)		fmt=elf em=tmips ;;
diff -Nurp a/ld/configure.tgt b/ld/configure.tgt
--- a/ld/configure.tgt
+++ b/ld/configure.tgt
@@ -95,6 +95,9 @@ aarch64-*-freebsd*)	targ_emul=aarch64fbs
 aarch64-*-fuchsia*)	targ_emul=aarch64elf
 			targ_extra_emuls="aarch64elfb armelf armelfb"
 			;;
+aarch64-*-l4re*)	targ_emul=aarch64elf
+			targ_extra_emuls="armelf"
+			;;
 aarch64_be-*-linux-gnu_ilp32)
 			targ_emul=aarch64linux32b
 			targ_extra_libpath="aarch64linuxb aarch64linux aarch64linux32 armelfb_linux_eabi armelf_linux_eabi"
@@ -242,6 +245,9 @@ arm*-*-fuchsia*)	targ_emul=armelf_fuchsi
 arm*-*-haiku*)		targ_emul=armelf_haiku
 			targ_extra_emuls=armelf
 			;;
+arm*-*-l4re*)		targ_emul=armelf_l4re
+			targ_extra_emuls=armelf
+			;;
 avr-*-*)		targ_emul=avr2
 			targ_extra_emuls="avr1 avr25 avr3 avr31 avr35 avr4 avr5 avr51 avr6 avrxmega1 avrxmega2 avrxmega2_flmap avrxmega3 avrxmega4 avrxmega4_flmap avrxmega5 avrxmega6 avrxmega7 avrtiny"
 			;;
@@ -383,7 +389,7 @@ i[3-7]86-*-openbsd*)
 i[3-7]86-*-elfiamcu)	targ_emul=elf_iamcu
 			targ_extra_emuls=elf_i386
 			;;
-i[3-7]86-*-elf* | i[3-7]86-*-rtems* | i[3-7]86-*-genode*)
+i[3-7]86-*-elf* | i[3-7]86-*-rtems* | i[3-7]86-*-genode* | i[3-7]86-*-l4re*)
 			targ_emul=elf_i386
 			targ_extra_emuls=elf_iamcu
 			;;
@@ -570,6 +576,22 @@ mips*-*-vxworks*)	targ_emul=elf32ebmipvx
 			;;
 mips*-*-windiss)	targ_emul=elf32mipswindiss
 			;;
+mips64*el-*-l4re* | mipsisa64*el-*-l4re*)
+			targ_emul=elf64ltsmip_l4re
+			targ_extra_emuls="elf64btsmip_l4re"
+			targ_extra_libpath="elf64ltsmip elf64btsmip elf32ltsmipn32 elf32btsmipn32 elf32ltsmip elf32btsmip"
+			;;
+mips64*-*-l4re* | mipsisa64*-*-l4re*)
+			targ_emul=elf64btsmip_l4re
+			targ_extra_emuls="elf64ltsmip_l4re"
+			targ_extra_libpath="elf64btsmip elf64ltsmip elf32btsmipn32 elf32ltsmipn32 elf32btsmip elf32ltsmip"
+			;;
+mips*el-*-l4re*)	targ_emul=elf32ltsmip
+			targ_extra_libpath="elf32btsmip elf32ltsmipn32 elf64ltsmip_l4re elf32btsmipn32 elf64btsmip_l4re"
+			;;
+mips*-*-l4re*)		targ_emul=elf32btsmip
+			targ_extra_libpath="elf32ltsmip elf32btsmipn32 elf64btsmip_l4re elf32ltsmipn32 elf64ltsmip_l4re"
+			;;
 mips64*el-*-linux-gnuabi64)
 			targ_emul=elf64ltsmip
 			targ_extra_libpath="elf64btsmip elf32ltsmipn32 elf32btsmipn32 elf32ltsmip elf32btsmip"
@@ -978,7 +1000,7 @@ x86_64-*-netbsd* | x86_64-*-openbsd*)
 			tdir_elf_i386=`echo ${targ_alias} | \
 			    sed -e 's/x86_64/i386/' -e 's/aout//'`
 			;;
-x86_64-*-elf* | x86_64-*-rtems* | x86_64-*-fuchsia* | x86_64-*-genode*)
+x86_64-*-elf* | x86_64-*-rtems* | x86_64-*-fuchsia* | x86_64-*-genode* | x86_64-*-l4re*)
 			targ_emul=elf_x86_64
 			targ_extra_libpath="elf_i386 elf_iamcu elf32_x86_64"
 			tdir_elf_i386=`echo ${targ_alias} | sed -e 's/x86_64/i386/'`
diff -Nurp a/ld/emulparams/armelf_l4re.sh b/ld/emulparams/armelf_l4re.sh
--- a/ld/emulparams/armelf_l4re.sh
+++ b/ld/emulparams/armelf_l4re.sh
@@ -0,0 +1,3 @@
+source_sh ${srcdir}/emulparams/armelf_linux_eabi.sh
+
+TEXT_START_ADDR=0x01000000
diff -Nurp a/ld/emulparams/elf64btsmip_l4re.sh b/ld/emulparams/elf64btsmip_l4re.sh
--- a/ld/emulparams/elf64btsmip_l4re.sh
+++ b/ld/emulparams/elf64btsmip_l4re.sh
@@ -0,0 +1,4 @@
+source_sh ${srcdir}/emulparams/elf64btsmip.sh
+
+# L4Re has a 32-bit user address space on MIPS64.
+TEXT_START_ADDR=0x400000
diff -Nurp a/ld/emulparams/elf64ltsmip_l4re.sh b/ld/emulparams/elf64ltsmip_l4re.sh
